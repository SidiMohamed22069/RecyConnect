# Modele de configuration locale.
#   cp application.properties.example application.properties
#
# Ce fichier est versionne, application.properties ne l'est PAS.
# N'y placer aucune valeur reelle de secret.

spring.application.name=RecyConnect
server.port=${SERVER_PORT:8081}

# --- PostgreSQL ---
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/RecyConnect}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}

# --- JPA ---
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.properties.hibernate.jdbc.lob.non_contextual_creation=true
# Les controleurs ne renvoient que des DTO: aucune association lazy n'est
# resolue pendant le rendu de la reponse.
spring.jpa.open-in-view=false

# --- Securite JWT ---
# OBLIGATOIRE. Minimum 32 octets. Generer avec: openssl rand -base64 48
jwt.secret=${JWT_SECRET}
# Duree de validite d'un token en minutes (1380 = 23 h)
jwt.expiration-minutes=${JWT_EXPIRATION_MINUTES:1380}

# Duree de vie du jeton de rafraichissement, en jours (point H4 de l'audit
# mobile). Long par construction: c'est ce qui evite de redemander le mot de
# passe a chaque expiration du jeton d'acces. La revocation ne repose pas sur
# cette duree mais sur la session — deconnexion, connexion depuis un autre
# appareil ou reinitialisation du mot de passe l'invalident immediatement.
jwt.refresh-expiration-days=${JWT_REFRESH_EXPIRATION_DAYS:30}

# --- Compte administrateur d'amorcage ---
# Cree au demarrage si le numero n'est pas deja pris (voir AdminSeeder).
# Indispensable sur une base neuve: /api/auth/register-admin exige deja un ADMIN.
# Sans mot de passe renseigne, le seeder ne cree rien et le signale au demarrage.
app.admin-seed.enabled=${ADMIN_SEED_ENABLED:true}
app.admin-seed.username=${ADMIN_SEED_USERNAME:admin}
app.admin-seed.phone=${ADMIN_SEED_PHONE:22222222}
app.admin-seed.password=${ADMIN_SEED_PASSWORD:}

# --- Catalogue des categories (donnee de reference) ---
# Cree les categories de dechets recyclables au demarrage si elles manquent,
# et complete les traductions absentes (voir CategorySeeder).
# Sans elles, le filtre de l'accueil est vide et le depot d'annonce n'offre
# aucun choix: actif par defaut, en local comme en production.
app.category-seed.enabled=${CATEGORY_SEED_ENABLED:true}

# --- Jeu de donnees de demonstration ---
# Quatre comptes mauritaniens, dix annonces situees dans Nouakchott et leurs
# offres (voir DemoSeeder).
# Desactive par defaut: des annonces fictives sur un environnement ouvert au
# public seraient prises pour de vraies offres.
app.demo-seed.enabled=${DEMO_SEED_ENABLED:false}
app.demo-seed.password=${DEMO_SEED_PASSWORD:}

# --- Upload de fichiers ---
file.upload-dir=${FILE_UPLOAD_DIR:uploads}
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# --- URLs de l'application ---
# app.client.url: origines autorisees par le CORS, separees par des virgules
app.client.url=${APP_CLIENT_URL:http://localhost:4200}
app.server.url=${APP_SERVER_URL:http://localhost}

# --- SMS Chinguisoft ---
sms.chinguisoft.validation-key=${SMS_VALIDATION_KEY}
sms.chinguisoft.token=${SMS_TOKEN}
sms.chinguisoft.base-url=${SMS_BASE_URL:https://chinguisoft.com/api/sms/validation}
sms.chinguisoft.lang=fr

# --- Firebase Cloud Messaging ---
# En local, deposer la cle dans src/main/resources/ (fichier gitignore).
# Un chemin sans prefixe est lu dans le classpath; utiliser "file:/chemin/absolu.json"
# pour lire hors du classpath (c'est ce que fait le profil prod).
# Laisser vide desactive proprement les notifications push.
fcm.service-account-key=${FCM_SERVICE_ACCOUNT_KEY:service-account-key.json}
fcm.project-id=${FCM_PROJECT_ID:}

# --- Politique de version de l'application mobile ---
# Servie par GET /api/app/version, lue par le mobile a chaque demarrage.
#   app.version.minimum : en deca, l'application affiche un ecran bloquant dont
#                         on ne sort qu'en mettant a jour.
#   app.version.latest  : au-dessus, une mise a jour facultative est proposee.
#
# Vides par defaut, et c'est deliberé: ces deux lignes sont les seules de toute
# la configuration capables de rendre l'application inutilisable pour tout le
# parc installe. Bloquer un parc doit etre un acte explicite d'exploitation, pas
# l'effet de bord d'un deploiement. Tant qu'elles sont vides, le mobile ne
# verifie rien et se comporte comme avant.
#
# Ne jamais renseigner un minimum superieur a ce qui est REELLEMENT publie sur
# le magasin: l'utilisateur serait enferme devant un bouton sans effet. Le
# service ramene d'office un minimum trop haut a app.version.latest et omet
# toute valeur illisible plutot que de la transmettre (voir AppVersionService).
app.version.latest=${APP_VERSION_LATEST:}
app.version.minimum=${APP_VERSION_MINIMUM:}
app.version.android-url=${APP_VERSION_ANDROID_URL:https://play.google.com/store/apps/details?id=com.recyconnect.app.neyan}
app.version.ios-url=${APP_VERSION_IOS_URL:}
