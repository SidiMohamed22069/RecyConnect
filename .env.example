# Copier ce fichier en .env et renseigner les valeurs
# cp .env.example .env
#
# Ne jamais committer le fichier .env.

# --- Base de donnees (OBLIGATOIRE) ---
DB_PASSWORD=

# --- Securite JWT (OBLIGATOIRE) ---
# Minimum 32 octets. Generer avec: openssl rand -base64 48
# Changer ce secret invalide tous les tokens en circulation.
JWT_SECRET=
# Duree de validite d'un token en minutes (1380 = 23 h)
JWT_EXPIRATION_MINUTES=1380

# --- API SMS Chinguisoft (OBLIGATOIRE) ---
SMS_VALIDATION_KEY=
SMS_TOKEN=

# --- URLs (OBLIGATOIRE en production) ---
# APP_CLIENT_URL: origines autorisees par le CORS, separees par des virgules
# Exemple: https://app.recyconnect.mr,https://admin.recyconnect.mr
APP_CLIENT_URL=
# APP_SERVER_URL: URL publique de l'API, utilisee pour construire les liens de fichiers
APP_SERVER_URL=

# --- Compte administrateur d'amorcage (OPTIONNEL) ---
# Cree au demarrage si le numero n'est pas deja pris. Desactive par defaut en
# production: ne l'activer que le temps d'amorcer une base neuve, avec un mot de
# passe fort, puis le repasser a false.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PHONE=22222222
ADMIN_SEED_PASSWORD=

# --- Catalogue des categories (donnee de reference) ---
# Cree les cinq categories de dechets recyclables et complete leurs traductions
# au demarrage. Laisser a true: sans categories, l'application mobile n'affiche
# aucun filtre et le depot d'annonce est impossible.
CATEGORY_SEED_ENABLED=true

# --- Jeu de donnees de demonstration (OPTIONNEL) ---
# Quatre comptes mauritaniens, dix annonces situees dans Nouakchott et leurs
# offres, pour une demonstration.
# A laisser a false partout ailleurs: des annonces fictives passeraient pour de
# vraies offres. Le mot de passe est commun aux quatre comptes.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=recyconnect-24ffd
# Chemin, sur la machine hote, du fichier de cle de service Firebase.
# Il est monte en lecture seule dans le conteneur; il n'est jamais inclus dans l'image.
# Sans ce fichier, l'application demarre mais les notifications push sont desactivees.
FCM_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account-key.json

# --- Politique de version de l'application mobile (OPTIONNEL) ---
# Servie par GET /api/app/version, lue par le mobile a chaque demarrage.
# APP_VERSION_MINIMUM: en deca, l'application affiche un ecran bloquant dont on
# ne sort qu'en mettant a jour. Ne jamais y mettre une version qui n'est pas
# encore disponible sur le magasin.
# APP_VERSION_LATEST: au-dessus, une mise a jour facultative est proposee.
# Laisser vide desactive la verification: le mobile ne bloque alors personne.
APP_VERSION_LATEST=
APP_VERSION_MINIMUM=
APP_VERSION_ANDROID_URL=https://play.google.com/store/apps/details?id=com.recyconnect.app.neyan
# A renseigner le jour de la publication sur l'App Store.
APP_VERSION_IOS_URL=
