# Copier ce fichier en .env et renseigner les valeurs
# cp .env.example .env
#
# Ne jamais committer le fichier .env.

# --- Base de donnees (OBLIGATOIRE) ---
DB_PASSWORD=

# --- Securite JWT (OBLIGATOIRE) ---
# Minimum 32 octets. Generer avec: openssl rand -base64 48
# Changer ce secret invalide tous les tokens en circulation.
JWT_SECRET=
# Duree de validite d'un token en minutes (1380 = 23 h)
JWT_EXPIRATION_MINUTES=1380

# --- API SMS Chinguisoft (OBLIGATOIRE) ---
SMS_VALIDATION_KEY=
SMS_TOKEN=

# --- URLs (OBLIGATOIRE en production) ---
# APP_CLIENT_URL: origines autorisees par le CORS, separees par des virgules
# Exemple: https://app.recyconnect.mr,https://admin.recyconnect.mr
APP_CLIENT_URL=
# APP_SERVER_URL: URL publique de l'API, utilisee pour construire les liens de fichiers
APP_SERVER_URL=

# --- Compte administrateur d'amorcage (OPTIONNEL) ---
# Cree au demarrage si le numero n'est pas deja pris. Desactive par defaut en
# production: ne l'activer que le temps d'amorcer une base neuve, avec un mot de
# passe fort, puis le repasser a false.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PHONE=22222222
ADMIN_SEED_PASSWORD=

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=recyconnect-24ffd
# Chemin, sur la machine hote, du fichier de cle de service Firebase.
# Il est monte en lecture seule dans le conteneur; il n'est jamais inclus dans l'image.
# Sans ce fichier, l'application demarre mais les notifications push sont desactivees.
FCM_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account-key.json
